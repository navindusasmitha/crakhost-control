# CrakMail / docker-mailserver lightweight profile
# Copy to mailserver.env and edit only when needed.

OVERRIDE_HOSTNAME=${CRAKMAIL_HOSTNAME}
POSTMASTER_ADDRESS=postmaster@${CRAKMAIL_DOMAIN}
REPORT_RECIPIENT=postmaster@${CRAKMAIL_DOMAIN}

# Keep the base stack lightweight. Add Rspamd/ClamAV only if you intentionally
# accept the extra memory/CPU cost.
ENABLE_AMAVIS=0
ENABLE_CLAMAV=0
ENABLE_SPAMASSASSIN=0
ENABLE_RSPAMD=0
ENABLE_FAIL2BAN=0

# Authentication / protocols
ENABLE_SASLAUTHD=0
ENABLE_POP3=0
ENABLE_IMAP=1
SMTP_ONLY=0

# Domain authentication
ENABLE_OPENDKIM=1
ENABLE_OPENDMARC=1
ENABLE_POLICYD_SPF=1

# TLS certificates are issued on the host with certbot and mounted read-only.
SSL_TYPE=letsencrypt
TLS_LEVEL=modern

# File-based mailbox provisioning keeps the stack simple.
ACCOUNT_PROVISIONER=FILE
SPOOF_PROTECTION=1

# Sensible limits for a small VPS mail host.
POSTFIX_MESSAGE_SIZE_LIMIT=52428800
DOVECOT_MAILBOX_FORMAT=maildir
DOVECOT_INET_PROTOCOLS=ipv4
POSTFIX_INET_PROTOCOLS=ipv4

# Do not trust the whole Docker network as an SMTP relay. Authenticated users
# submit mail on 587/465; internet MTAs deliver inbound mail on 25.
PERMIT_DOCKER=none
