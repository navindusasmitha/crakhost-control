POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
DATABASE_URL=postgresql://crakhost:replace-with-a-long-random-postgres-password@postgres:5432/crakhost
REDIS_URL=redis://redis:6379
SESSION_SECRET=replace-with-a-long-random-session-secret

# Public panel URL used by transactional email templates
APP_URL=https://panel.example.com

# CrakNode runtime API authentication
CRAKNODE_URL=http://craknode:8088
CRAKNODE_TOKEN=replace-with-a-long-random-node-token

# Automatic node registration / heartbeat
CRAKNODE_PANEL_URL=http://panel:4310
CRAKNODE_REGISTRATION_TOKEN=replace-with-a-separate-long-random-registration-token
CRAKNODE_NAME=example-node-01
CRAKNODE_LOCATION=Example Location
CRAKNODE_PUBLIC_URL=http://craknode:8088
CRAKNODE_HEARTBEAT_INTERVAL=60

# Runtime policy. Add only images you explicitly trust, comma-separated.
CRAKNODE_ALLOWED_IMAGES=itzg/minecraft-server:latest
CRAKNODE_MAX_SERVER_MEMORY_MB=32768
CRAKNODE_MAX_SERVER_CPU=16
CRAKNODE_TRANSFER_MAX_MB=512
CRAKNODE_AUTO_PERFORMANCE=true
CRAKNODE_PERFORMANCE_INTERVAL=15

# Panel provisioning safety. A node must still have at least the larger of
# this fixed reserve or the percentage reserve after a new disk allocation.
CRAKHOST_NODE_DISK_RESERVE_MB=2048
CRAKHOST_NODE_MIN_DISK_FREE_PERCENT=10

# Hostname customers use for managed PostgreSQL connections
DB_PUBLIC_HOST=127.0.0.1

# Optional DNS resolvers for managed game containers
DOCKER_DNS_1=1.1.1.1
DOCKER_DNS_2=8.8.8.8

# Persistent production volume names
CRAKHOST_PGDATA_VOLUME=crakhost-pgdata
CRAKHOST_BACKUPS_VOLUME=crakhost-node-backups

PANEL_DOMAIN=panel.example.com
ACME_EMAIL=admin@example.com
CRAKHOST_GITHUB_REPO=navindusasmitha/crakhost-control
CRAKHOST_RELEASE_CHANNEL=stable

# CrakMail v0.47 self-hosted mail platform.
# The installer fills these from: sudo bash scripts/install-crakmail-host.sh example.com <PUBLIC_IPV4>
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
MAIL_PUBLIC_IP=203.0.113.10
CRAKMAIL_DKIM_SELECTOR=mail
CRAKMAIL_DKIM_SYNC_SECONDS=30
CRAKMAIL_WEBMAIL_URL=https://mail.example.com
CRAKMAIL_PORT25_PROBE_HOST=gmail-smtp-in.l.google.com
CRAKMAIL_MAIL_VOLUME=crakhost-mail-vhosts
CRAKMAIL_STATE_VOLUME=crakhost-mail-state
CRAKMAIL_WEBMAIL_VOLUME=crakhost-roundcube-db
