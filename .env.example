POSTGRES_PASSWORD=change-me-now
DATABASE_URL=postgresql://crakhost:change-me-now@localhost:5432/crakhost
REDIS_URL=redis://localhost:6379
CRAKNODE_URL=http://localhost:8088
CRAKNODE_TOKEN=replace-with-a-long-random-node-token
SESSION_SECRET=replace-with-a-long-random-session-secret

# Hostname customers use for managed PostgreSQL connections
DB_PUBLIC_HOST=127.0.0.1

# Optional DNS resolvers for game containers (helps Docker Desktop DNS failures)
DOCKER_DNS_1=1.1.1.1
DOCKER_DNS_2=8.8.8.8
# v0.11 persistent volume names (normally leave unchanged for upgrades)
CRAKHOST_PGDATA_VOLUME=crakhost-control-v04_pgdata
CRAKHOST_MINECRAFT_VOLUME=crakhost-control-v04_minecraft_data
CRAKHOST_BACKUPS_VOLUME=crakhost-control-v04_craknode_backups

PANEL_DOMAIN=panel.example.com
ACME_EMAIL=admin@example.com
CRAKHOST_GITHUB_REPO=navindusasmitha/crakhost-control
CRAKHOST_RELEASE_CHANNEL=stable